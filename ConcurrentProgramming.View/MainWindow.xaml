<Window x:Class="ConcurrentProgramming.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:ConcurrentProgramming.ViewModel;assembly=ConcurrentProgramming.ViewModel"
        mc:Ignorable="d"
        Title="Programowanie współbieżne kulki" Height="450" Width="800"
        ResizeMode="CanResize">
    <Window.DataContext>
        <viewModel:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
            <DockPanel>
                <Label VerticalContentAlignment="Center">Ilość kulek</Label>
                <TextBox VerticalContentAlignment="Center"
                         Text="{Binding BallsToAdd}"/>
            </DockPanel>
            
            <DockPanel>
                <Label VerticalContentAlignment="Center">Szerokość Stołu</Label>
                <TextBox VerticalContentAlignment="Center"
                         Text="{Binding Width}"/>
            </DockPanel>
            
            <DockPanel>
                <Label VerticalContentAlignment="Center">Wysokość Stołu</Label>
                <TextBox VerticalContentAlignment="Center"
                         Text="{Binding Height}"/>
            </DockPanel>
            
            <Button Command="{Binding AddBallsCommand}">Dodaj kulki</Button>
        </StackPanel>
        
        <Viewbox Grid.Column="1" Stretch="Uniform">
            <Canvas Width="{Binding Width}" Height="{Binding Height}">
                <Rectangle
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    Fill="LightGray"
                    Stroke="Black" >
                </Rectangle>
                
                <ItemsControl ItemsSource="{Binding Balls}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas>
                            </Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse 
                                Height="{Binding Diameter}"
                                Width="{Binding Diameter}"
                                Fill="DarkGray"
                                Stroke="Black"
                            />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
